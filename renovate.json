{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 9am on Monday"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group all GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group Go module minor/patch updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Go modules (minor/patch)"
    },
    {
      "description": "Separate PRs for Go module major updates — review individually",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "Group Charm Bracelet TUI library updates (bubbletea + bubbles + lipgloss + huh + glamour)",
      "matchPackagePatterns": ["^github.com/charmbracelet/"],
      "groupName": "Charm Bracelet TUI libs"
    }
  ]
}
